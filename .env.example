# Copy to .env (never commit .env).
# LLM_BACKEND: ollama (default), gateway (through the CS54 gateway, phase 7) or fake (no model needed, used by tests)
LLM_BACKEND=ollama
OLLAMA_URL=http://localhost:11434
CHATBOT_MODEL=llama3.2:3b
# Access key for both chat endpoints (PB-05). Choose your own long random value; never commit .env.
CHATBOT_API_KEY=
# Phase 7: the CS54 gateway and this app's own gateway key (not a provider key).
GATEWAY_URL=http://localhost:4000
GATEWAY_KEY=
